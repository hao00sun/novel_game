# 推荐：运行 `python -m novel_world --configure`，由终端向导生成 .env。
# mock = no API, deterministic fallback
# api  = OpenAI-compatible /chat/completions
NOVEL_WORLD_PROVIDER=mock

# Only required when provider=api
NOVEL_WORLD_BASE_URL=https://your-provider.example/v1
NOVEL_WORLD_API_KEY=your_api_key
NOVEL_WORLD_MODEL=your_model_name
